{
  "version": 1,
  "policies": [
    {
      "id": "ADR-021",
      "title": "Gated Agentic Development Loop",
      "adrPath": "architecture/adrs/021-gated-agentic-development-loop.md",
      "rules": [
        {
          "id": "workflow-guardrail-sync",
          "whenAny": [
            "skills/implement/SKILL.md",
            "skills/implement/_development-principles.md",
            "skills/implement/steps/**",
            "skills/quickfix/SKILL.md",
            "skills/integrate/SKILL.md",
            "skills/review/SKILL.md",
            "skills/review/steps/**",
            ".claude/skills/implement/SKILL.md",
            ".claude/skills/integrate/SKILL.md",
            ".claude/rules/*.md",
            ".github/PULL_REQUEST_TEMPLATE.md",
            "AGENTS.md"
          ],
          "requireAll": [
            "docs/DEVELOPMENT_WORKFLOW.md",
            "docs/WORKFLOW.md"
          ],
          "requireAny": [
            "architecture/adrs/021-gated-agentic-development-loop.md",
            "architecture/adrs/029-issue-thread-gate-model.md",
            "architecture/adrs/031-codex-review-stopping-model.md",
            "architecture/adrs/036-per-step-routing-tool-surfaces-telemetry.md",
            "skills/quickfix/SKILL.md"
          ],
          "message": "Workflow guardrails changed without syncing the workflow documents and at least one gate-model record (ADR-021 / ADR-029 / ADR-031 / ADR-036, or the /quickfix sibling lane)."
        }
      ]
    },
    {
      "id": "ADR-014",
      "title": "Pluggable Verification Architecture",
      "adrPath": "architecture/adrs/014-pluggable-verification-architecture.md",
      "rules": []
    },
    {
      "id": "ADR-012",
      "title": "Formal Methods Development Process",
      "adrPath": "architecture/adrs/012-formal-methods-process.md",
      "rules": []
    },
    {
      "id": "ADR-054",
      "title": "Documentation Coverage Gate",
      "adrPath": "architecture/adrs/054-documentation-coverage-gate.md",
      "rules": [
        {
          "id": "doc-coverage-gate-sync",
          "whenAny": [
            "mcp/ground-control/lib.js",
            "mcp/ground-control/lib/doc-coverage.js",
            "mcp/ground-control/index.js",
            "tools/policy/checks.py",
            "tools/install-vale.sh",
            ".vale.ini",
            "docs/DOC_STYLE.md"
          ],
          "triggerContent": {
            "mcp/ground-control/lib.js": "documentation.?[Cc]overage|doc_?[Tt]argets|surface_?[Cc]lass|DOC_STYLE",
            "mcp/ground-control/lib/doc-coverage.js": "documentation.?[Cc]overage|doc_?[Tt]argets|surface_?[Cc]lass|DOC_STYLE",
            "tools/policy/checks.py": "documentation_coverage|doc_targets|surface_class|DOC_STYLE"
          },
          "requireAll": [
            "architecture/adrs/054-documentation-coverage-gate.md",
            "docs/DOC_STYLE.md"
          ],
          "message": "Documentation coverage gate surfaces changed without syncing ADR-054 and DOC_STYLE.md."
        }
      ]
    },
    {
      "id": "ADR-090",
      "title": "Production-Line Measurement Model",
      "adrPath": "architecture/adrs/090-production-line-measurement-model.md",
      "rules": []
    }
  ]
}
