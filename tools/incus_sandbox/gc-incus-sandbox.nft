table inet gc_incus_sandbox {
  set host_ipv4 { type ipv4_addr; flags interval; }
  set dns_ipv4 { type ipv4_addr; flags interval; }

  chain input {
    type filter hook input priority 0; policy accept;
    iifname "gcbr0" udp dport { 67, 68 } accept
    iifname "gcbr0" ip daddr @host_ipv4 drop
    iifname "gcbr0" ip6 daddr ::/0 drop
  }

  chain forward {
    type filter hook forward priority 0; policy accept;
    ct state established,related accept
    iifname "gcbr0" oifname "gcbr0" drop
    iifname "gcbr0" ip daddr @host_ipv4 drop
    iifname "gcbr0" udp dport { 53, 67, 68 } ip daddr @dns_ipv4 accept
    iifname "gcbr0" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15 } drop
    iifname "gcbr0" ip6 daddr ::/0 drop
    iifname "gcbr0" tcp dport 443 accept
    iifname "gcbr0" drop
  }
}
