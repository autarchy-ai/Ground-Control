{
  "name": "grndctl",
  "version": "1.2.1",
  "description": "Ground Control: the MCP server and workflow skills for gated agentic development (/implement, /quickfix, /review).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autarchy-ai/Ground-Control.git",
    "directory": "mcp/ground-control"
  },
  "homepage": "https://github.com/autarchy-ai/Ground-Control#readme",
  "type": "module",
  "main": "index.js",
  "bin": {
    "grndctl": "bin/grndctl.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "index.js",
    "server-runtime.js",
    "lib.js",
    "gc-implement-mechanical.js",
    "gc-integrate.js",
    "knowledge_ingest.js",
    "knowledge_ingest_cli.js",
    "lib/",
    "tools/",
    "implement/",
    "gc-integrate/",
    "knowledge_ingest/",
    "skills/",
    "sandbox/",
    "templates/",
    "!skills/**/tests/",
    "!**/*.test.js",
    "!**/*.test-helpers.js"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node scripts/run-node-tests.mjs $(ls *.test.js | grep -v '^openapi-contract\\.')",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "node scripts/bundle-skills.mjs",
    "postpack": "node scripts/bundle-skills.mjs --clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "js-yaml": "^4.3.2",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^4.8.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@humanfs/node": "0.16.8",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.3.1",
    "qs": "6.16.0"
  }
}
